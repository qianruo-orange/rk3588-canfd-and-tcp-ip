[Unit]
Description=RK3588 Edge Gateway H.265 RTSP pusher (FIFO -> mediamtx)
After=mediamtx.service rk3588-edge-gateway.service
Requires=mediamtx.service rk3588-edge-gateway.service
PartOf=rk3588-edge-gateway.service

[Service]
Type=simple
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -f hevc -fflags nobuffer -use_wallclock_as_timestamps 1 -i /run/rk3588-edge-gateway/hevc.fifo -c copy -an -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/live
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
