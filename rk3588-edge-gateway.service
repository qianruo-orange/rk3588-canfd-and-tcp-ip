[Unit]
Description=RK3588 Edge Gateway Service (CAN FD / TCP / Video / AI)
After=network.target

[Service]
Type=notify
NotifyAccess=all

WorkingDirectory=/opt/rk3588-edge-gateway
ExecStart=/opt/rk3588-edge-gateway/bin/rk3588-edge-gateway

WatchdogSec=10
Restart=on-failure
RestartSec=5
TimeoutStartSec=15

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rk3588-edge-gateway/logs /opt/rk3588-edge-gateway/config /opt/rk3588-edge-gateway/recordings
ReadOnlyPaths=/opt/rk3588-edge-gateway/html

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rk3588-edge-gateway

[Install]
WantedBy=multi-user.target
