// =============================================================
// DBC 格式说明（示例文件）
// 启用方式：取消 config.txt 中 `dbc_path config/example.dbc` 前的 `#`
// =============================================================
//
// 解析器（source/can/dbc_parser.c）只识别以下两类行，其余行均忽略：
//
// 1) 报文行：BO_ <ID> <报文名>: <DLC> <发送节点>
//    BO_ 256 EngineData: 8 Gateway
//    - ID：十进制 CAN ID
//    - 标准帧：0 ~ 0x7FF（2047）
//    - 扩展帧：0x80000000 | (29 位 ID)，即最高位 bit31 置 1 表示扩展帧
//      例：扩展帧 0x18FF50E5 写作十进制 2566869221
//    - DLC：数据长度（字节），经典 CAN 0 ~ 8
//
// 2) 信号行：SG_ <信号名> : <起始位>|<长度>@<字节序><符号> (<因子>,<偏移>) [<最小>|<最大>] "<单位>" <接收节点>
//    SG_ EngineSpeed : 0|16@1+ (0.25,0) [0|16383.75] "rpm" Gateway
//    - 起始位：信号在报文中的最低位偏移（从 0 起）
//    - 长度：信号位宽
//    - 字节序：1 = Intel(小端/LSB first)，0 = Motorola(大端/MSB first)
//    - 符号：+ 无符号，- 有符号（补码）
//    - 因子/偏移：物理值 = 原始值 * 因子 + 偏移
//    - 最小/最大/单位：可选，用于数值说明与显示
//
// 注：`//` 为注释行，解析时自动跳过。
// =============================================================

VERSION "1.0"

NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_TYPE_REF_
	VAL_TABLE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_
	BO_TX_BU_
	BA_DEF_REL_
	BA_REL_
	BA_DEF_DEF_REL_
	BU_SG_REL_
	BU_EV_REL_
	BU_BO_REL_
	SIG_GROUP_REL_

BS_:

BU_: Engine Battery Gateway

BO_ 256 EngineData: 8 Gateway
 SG_ EngineSpeed : 0|16@1+ (0.25,0) [0|16383.75] "rpm" Gateway
 SG_ EngineTemp : 16|8@1+ (1,-40) [-40|215] "degC" Gateway
 SG_ ThrottlePos : 24|8@1+ (0.4,0) [0|100] "%" Gateway
 SG_ EngineLoad : 32|16@1+ (0.001,0) [0|65.535] "%" Gateway

BO_ 512 BatteryStatus: 8 Gateway
 SG_ Voltage : 0|16@1+ (0.001,0) [0|65.535] "V" Gateway
 SG_ Current : 16|16@1- (0.1,0) [-3276.8|3276.7] "A" Gateway
 SG_ Soc : 32|8@1+ (0.5,0) [0|100] "%" Gateway
 SG_ Temp : 40|8@1+ (1,-40) [-40|215] "degC" Gateway

BO_ 770 Status: 4 Gateway
 SG_ Gear : 0|4@1+ (1,0) [0|15] "" Gateway
 SG_ MotorSpeed : 8|16@0+ (1,0) [0|65535] "rpm" Gateway

BO_ 2566869221 VehiclePos: 8 Gateway
 SG_ Latitude : 0|32@1- (0.0000001,0) [-90|90] "deg" Gateway
 SG_ Longitude : 32|32@1- (0.0000001,0) [-180|180] "deg" Gateway
